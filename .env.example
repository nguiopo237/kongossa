# ============================================
# KONGOSSA - ENVIRONMENT VARIABLES (EXAMPLE)
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS commit le fichier .env !

# --- Cloudinary (Set 1) ---
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY_1=votre_api_key_1
CLOUDINARY_API_SECRET_1=votre_api_secret_1

# --- Cloudinary (Set 2) ---
CLOUDINARY_API_KEY_2=votre_api_key_2
CLOUDINARY_API_SECRET_2=votre_api_secret_2

# --- Cloudinary URL complète ---
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- OneSignal ---
ONESIGNAL_APP_ID=votre_onesignal_app_id
ONESIGNAL_API_KEY=votre_onesignal_api_key

# --- Firebase FCM ---
FCM_SERVER_KEY=votre_fcm_server_key
FCM_SERVER_KEY_ALT=votre_fcm_server_key_alt

# --- Firebase ---
FIREBASE_API_KEY_ANDROID=votre_api_key_android
FIREBASE_API_KEY_IOS=votre_api_key_ios
FIREBASE_APP_ID=votre_app_id
FIREBASE_MESSAGING_SENDER_ID=votre_sender_id
FIREBASE_PROJECT_ID=votre_project_id
FIREBASE_STORAGE_BUCKET=votre_storage_bucket
FIREBASE_IOS_BUNDLE_ID=votre_bundle_id
